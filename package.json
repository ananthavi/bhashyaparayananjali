{
  "name": "bhashya-parayana",
  "description": "Offline-friendly PWA for parayanam of Adi Shankaracharya's Prasthanatrayi Bhashyas with Malayalam transliteration, search, and Sanskrit dictionary lookup.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:one": "tsx scripts/scrape.ts --only",
    "build:index": "tsx scripts/build-search-index.ts",
    "data:all": "npm run scrape && npm run build:index",
    "icons:web": "tsx scripts/build-icons.ts",
    "icons:android": "tsx scripts/build-android-icons.ts",
    "icons:ios": "tsx scripts/build-ios-icons.ts",
    "dict:build": "tsx scripts/build-dict.ts",
    "dict:reduce": "tsx scripts/dict-reduce.ts",
    "dict:coverage": "tsx scripts/dict-coverage.ts",
    "split:bhashya": "tsx scripts/split-bhashya.ts",
    "verify:linking": "tsx scripts/verify-linking.ts",
    "extract:glosses": "tsx scripts/extract-bhashya-glosses.ts",
    "build:meanings": "tsx scripts/build-meanings.ts",
    "audit:corpus-volume": "tsx scripts/audit-corpus-volume.ts",
    "translate:prepare": "tsx scripts/prepare-translation-batches.ts",
    "translate:ingest": "tsx scripts/ingest-agent-translations.ts",
    "smoke:vidyut": "tsx scripts/smoke-vidyut.ts",
    "build:tokens": "tsx scripts/build-search-tokens.ts",
    "cap:sync": "npm run build && npx cap sync && npm run icons:android && npm run icons:ios",
    "apk:debug": "npm run build && npx cap sync android && npm run icons:android && cd android && ./gradlew --no-daemon assembleDebug",
    "apk:release": "npm run build && npx cap sync android && npm run icons:android && cd android && ./gradlew --no-daemon assembleRelease",
    "ipa:debug": "npm run build && npx cap sync ios && npm run icons:ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -sdk iphoneos -archivePath ./build/App.xcarchive archive CODE_SIGNING_ALLOWED=NO"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@indic-transliteration/sanscript": "^1.3.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lunr": "^2.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lunr": "^2.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "eslint": "^9.16.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.1",
    "p-limit": "^6.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
